# Database
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=anime_db
POSTGRES_USER=anime_user
POSTGRES_PASSWORD=replace-me

# Auth
SECRET_KEY=replace-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BROWSER_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=amine-web-api
JWT_AUDIENCE=amine-web-browser
COOKIE_DOMAIN=.lnssy-cykj.online
ADMIN_SECRET_KEY=replace-me

# Email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=replace-with-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=True
EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_CODE_SEND_COOLDOWN_SECONDS=60
EMAIL_CODE_DEBUG=False

# Runtime
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=["https://lnssy-cykj.online","https://www.lnssy-cykj.online"]

# Optional: leave empty to keep current local-file and in-memory fallbacks.
REDIS_URL=
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET_NAME=
QINIU_DOMAIN=
